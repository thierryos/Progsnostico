# Modo `npm run dev:emulator`: SDK real do Firebase apontando para o emulador local
# (rode antes `npm run emulator`, que precisa de Java 11+). Nada vai para a produção.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-prognostico.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-prognostico
VITE_FIREBASE_STORAGE_BUCKET=demo-prognostico.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=demo
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_URL=http://127.0.0.1:9000?ns=demo-prognostico-default-rtdb
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1:9000
