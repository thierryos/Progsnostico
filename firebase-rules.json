{
  "rules": {
    "rooms": {
      ".read": true,
      ".indexOn": ["status", "createdAt", "lastActivity"],
      
      "$roomId": {
        ".write": true,
        
        ".validate": "newData.hasChild('status') && newData.hasChild('players') && newData.hasChild('currentRoom') && newData.hasChild('hostId') && newData.hasChild('createdAt')",
        
        "status": {
          ".validate": "newData.isString() && (newData.val() === 'menu' || newData.val() === 'room_browser' || newData.val() === 'waiting_room' || newData.val() === 'bidding' || newData.val() === 'playing' || newData.val() === 'trick_summary' || newData.val() === 'round_end' || newData.val() === 'game_over')"
        },
        
        "currentRoom": {
          ".validate": "newData.hasChild('id') && newData.hasChild('name') && newData.hasChild('maxPlayers') && newData.hasChild('status') && newData.hasChild('gameMode')",
          
          "id": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20 && newData.val() == $roomId"
          },
          
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50"
          },
          
          "maxPlayers": {
            ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 7"
          },
          
          "status": {
            ".validate": "newData.isString() && (newData.val() === 'open' || newData.val() === 'playing' || newData.val() === 'finished')"
          },
          
          "gameMode": {
            ".validate": "newData.isString() && (newData.val() === 'up' || newData.val() === 'up_down')"
          },
          
          "maxHandSize": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 13"
          },
          
          "totalRounds": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 26"
          },
          
          "isPrivate": {
            ".validate": "newData.isBoolean()"
          },
          
          "password": {
            ".validate": "!newData.exists() || newData.val() === null || (newData.isString() && newData.val().length <= 50)"
          },
          
          "players": {
            ".validate": "newData.hasChildren()"
          }
        },
        
        "players": {
          ".validate": "newData.hasChildren()"
        },
        
        "currentTurn": {
          ".validate": "!newData.exists() || newData.val() === null || newData.val() === '' || newData.isString()"
        },
        
        "currentTrickLeader": {
          ".validate": "!newData.exists() || newData.val() === null || newData.val() === '' || newData.isString()"
        },
        
        "round": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 13"
        },
        
        "roundIndex": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 26"
        },
        
        "totalRounds": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 26"
        },
        
        "startPlayerIndex": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 7"
        },
        
        "hostId": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50"
        },
        
        "createdAt": {
          ".validate": "newData.isNumber() && (!data.exists() || data.val() == newData.val())"
        },
        
        "lastActivity": {
          ".validate": "newData.isNumber() && newData.val() <= (now + 60000) && newData.val() >= (now - 60000)"
        },
        
        "deck": {
          ".validate": "newData.val() === null || newData.hasChildren()"
        },
        
        "tableCards": {
          ".validate": "newData.val() === null || newData.hasChildren()"
        },
        
        "trickHistory": {
          ".validate": "newData.val() === null || newData.hasChildren()"
        },
        
        "roundSequence": {
          ".validate": "newData.val() === null || newData.hasChildren()"
        },
        
        "trumpCard": {
          ".validate": "newData.val() === null || newData.hasChildren()"
        },
        
        "leadSuit": {
          ".validate": "newData.val() === null || newData.isString()"
        },
        
        "trickResult": {
          ".validate": "newData.val() === null || newData.hasChildren()"
        },
        
        "roundResults": {
          ".validate": "newData.val() === null || newData.hasChildren()"
        },
        
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
