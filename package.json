{
  "name": "prognostico",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fake": "vite --mode fakedb",
    "dev:emulator": "vite --mode emulator",
    "emulator": "npx --yes firebase-tools@15 emulators:start --only database --project demo-prognostico",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:emulator": "npx --yes firebase-tools@15 emulators:exec --only database --project demo-prognostico \"vitest run src/net/firebase.emulator.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "firebase": "^12.7.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gh-pages": "^6.2.0",
    "globals": "^17.0.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.2.0",
    "vitest": "^3.2.7"
  }
}
